DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/app_modulardegestion
ENV=development
CORS_ORIGINS=http://localhost:5173

# Firma los JWT de sesión (ver app/core/security.py). El valor de acá abajo
# es SOLO para desarrollo local — en producción hay que generar uno propio
# (ej. `python -c "import secrets; print(secrets.token_urlsafe(48))"`) y
# nunca reusar este ni comitearlo.
JWT_SECRET_KEY=dev-secret-no-usar-en-produccion
